# ===== LLM Providers (set at least one) =====
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=groq                        # "groq", "anthropic", or "openai"
LLM_MODEL=llama-3.3-70b-versatile        # or claude-sonnet-4-6, gpt-4o-mini etc.
# Note: if LLM_PROVIDER's key is missing, the factory falls back to
# whichever key IS present (groq -> openai -> anthropic), and to a
# deterministic offline stub if none are set at all.

# ===== Vector DB =====
# If PINECONE_API_KEY is empty, the app falls back to an in-memory
# dense vector store (numpy cosine similarity) so the POC runs with
# zero external dependencies. Set these to use real Pinecone.
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=enterprise-kb

# ===== LangSmith (Observability) - Mandatory per spec =====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-ai-assistant

# ===== Security =====
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ===== Rate Limiting (token bucket) =====
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=0.5

# ===== MCP Dummy Server =====
MCP_SERVER_URL=http://localhost:8100

# ===== App =====
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
